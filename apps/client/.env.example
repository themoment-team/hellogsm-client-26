NEXT_PUBLIC_API_BASE_URL=running-url
NEXT_PUBLIC_CHANNEL_IO_KEY=
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# OAuth 로그인 (/api/auth/oauth). 비어 있으면 로그인 시작 경로가 500을 응답합니다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REST_API_KEY=

# 생기부 OCR — school-record-ocr Route는 objectKey만 받아 OCR Lambda(apps/ocr-lambda)를
# 동기 호출하고 결과를 중계한다. 아래 자격 증명은 lambda:InvokeFunction 권한만 있으면 된다.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OCR_LAMBDA_FUNCTION_NAME=

# Sentry (선택 - 계정 생성 후 값 채워 넣으면 활성화됩니다)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# 상용 환경 테스트 시 true로 설정하면 페이지 진입·원서 작성 버튼 클릭 시 테스트 안내 모달을 띄웁니다.
NEXT_PUBLIC_IS_TEST_PERIOD=
